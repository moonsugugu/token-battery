{
  "name": "token-battery",
  "productName": "TokenBattery",
  "version": "1.3.5",
  "description": "TokenBattery (토큰배터리) — Claude·Codex 사용 한도를 배터리처럼 보여주는 캐릭터 위젯. 구독 결제일과 코딩 BGM도 한곳에서 · made by 문수네집",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip --universal"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2"
  },
  "allowScripts": {
    "electron@44.4.5": true
  },
  "author": "문수네집 (moonsune.zip)",
  "build": {
    "appId": "com.moonsune.tokenbattery",
    "productName": "TokenBattery",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "moonsugugu",
      "repo": "token-battery",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**}",
      "!output{,/**}",
      "!build{,/**}",
      "!.cache{,/**}",
      "!.github{,/**}",
      "!tests{,/**}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "TokenBattery.Setup.${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon-512.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "TokenBattery-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TokenBattery",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
