{
  "name": "token-battery",
  "productName": "TokenBattery",
  "version": "1.0.1",
  "description": "TokenBattery (토큰배터리) — Claude·Codex 사용 한도를 배터리처럼 보여주는 캐릭터 위젯. 구독 결제일과 코딩 BGM도 한곳에서 · made by 문수네집",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.4.5": true
  },
  "author": "문수네집 (moonsune.zip)",
  "build": {
    "appId": "com.moonsune.tokenbattery",
    "productName": "TokenBattery",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**}",
      "!output{,/**}",
      "!build{,/**}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TokenBattery",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
